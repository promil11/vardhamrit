{
  "name": "vardhamrit-backend",
  "version": "1.0.0",
  "description": "Vardhamrit Chai API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/index.ts",
    "build": "tsc && cp -r src/migrations/*.sql dist/migrations/ 2>/dev/null || true && npm run build:frontends",
    "build:frontends": "node -e \"const fs=require('fs'); if(process.env.RENDER || !fs.existsSync('../app/dist') || !fs.existsSync('../admin/dist')){ const {execSync}=require('child_process'); console.log('Building frontends for Render...'); execSync('cd .. && npm install --include=dev && npm --workspace=admin run build && npm --workspace=app run export:web', {stdio:'inherit'}); }\"",
    "start": "node dist/index.js",
    "migrate": "ts-node src/migrations/runMigrations.ts",
    "seed": "ts-node src/seeds/002_production_seed.ts",
    "test": "ts-node src/tests/runAllTests.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.13.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
