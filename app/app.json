{
  "expo": {
    "name": "Vardhamrit Chai",
    "slug": "vardhamrit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vardhamrit",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#244222"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vardhamrit.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#244222"
      },
      "package": "com.vardhamrit.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#244222"
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
